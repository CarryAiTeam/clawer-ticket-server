{
  "schemaVersion": "1.0",
  "storage": {
    "root": "D:/ticket-exports",
    "retainRawSource": false,
    "redaction": {
      "omitPeople": false,
      "removeFields": ["phone", "email"]
    },
    "exportLimits": {
      "maxItems": 50,
      "maxAttachments": 500,
      "maxAttachmentBytes": 52428800,
      "maxTotalBytes": 536870912
    }
  },
  "profiles": {
    "ones-graphql-my-open": {
      "provider": "ones",
      "source": "graphql",
      "product": "project",
      "baseUrl": "https://tickets.example.com",
      "teamId": "REPLACE_WITH_APPROVED_TEAM_ID",
      "allowedHosts": ["tickets.example.com"],
      "allowedProjects": ["REPLACE_WITH_APPROVED_PROJECT_UUID"],
      "secretRef": "ONES_READ_TOKEN",
      "authentication": { "headerName": "Authorization", "scheme": "Bearer" },
      "requestBudget": { "maxConcurrent": 3, "maxRequestsPerMinute": 20 },
      "inlineMaxChars": 12000,
      "classificationRules": [
        {
          "name": "replace-with-classification-name",
          "field": "importantField",
          "fieldId": "REPLACE_WITH_CLASSIFICATION_FIELD_UUID",
          "equals": "REPLACE_WITH_CLASSIFICATION_VALUE",
          "class": "technical-change"
        }
      ]
    },
    "ones-browser-my-open": {
      "provider": "ones",
      "source": "browser",
      "product": "project",
      "baseUrl": "https://tickets.example.com",
      "teamId": "REPLACE_WITH_APPROVED_TEAM_ID",
      "allowedHosts": ["tickets.example.com"],
      "allowedProjects": ["REPLACE_WITH_APPROVED_PROJECT_UUID"],
      "requestBudget": { "maxConcurrent": 3, "maxRequestsPerMinute": 20 },
      "inlineMaxChars": 12000,
      "classificationRules": [
        {
          "name": "replace-with-classification-name",
          "field": "importantField",
          "fieldId": "REPLACE_WITH_CLASSIFICATION_FIELD_UUID",
          "equals": "REPLACE_WITH_CLASSIFICATION_VALUE",
          "class": "technical-change"
        }
      ],
      "browser": {
        "executablePath": "C:/Program Files/Google/Chrome/Application/chrome.exe",
        "autoLogin": {
          "email": "replace-with-local-login@example.com",
          "password": "REPLACE_WITH_LOCAL_PASSWORD",
          "loginUrl": "https://tickets.example.com/login"
        }
      }
    }
  }
}
